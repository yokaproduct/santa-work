# Unity YAML assets — force text diff and let UnityYAMLMerge handle 3-way merges.
*.cs        text diff=csharp
*.cginc     text
*.shader    text

*.mat       merge=unityyamlmerge eol=lf
*.anim      merge=unityyamlmerge eol=lf
*.unity     merge=unityyamlmerge eol=lf
*.prefab    merge=unityyamlmerge eol=lf
*.physicsMaterial2D merge=unityyamlmerge eol=lf
*.physicMaterial    merge=unityyamlmerge eol=lf
*.asset     merge=unityyamlmerge eol=lf
*.meta      merge=unityyamlmerge eol=lf
*.controller merge=unityyamlmerge eol=lf

# "physicsMaterial2D" is available from Unity 5.6 onwards. If you're upgrading
# a project from before this version, remove the entry above and use:
# *.physicsMaterial2D merge=unityyamlmerge eol=lf

# Unity uses UTF-8 with a BOM in some legacy contexts; treat as binary if merges misbehave.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.psd  binary
*.tga  binary
*.tif  binary
*.wav  binary
*.mp3  binary
*.ogg  binary
*.fbx  binary
*.ttf  binary
*.otf  binary
